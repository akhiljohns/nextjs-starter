#!/usr/bin/env sh

# Commit message validation
# Format: scope: short description
# Example: user-profile: Add profile avatar upload

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Regex pattern: scope: description
# - scope: lowercase letters, hyphens, numbers
# - followed by colon and space
# - then description (any characters)
pattern="^[a-z0-9-]+: .+"

# Conventional commit keywords to prevent
conventional_keywords="^(feat|fix|docs|test|chore|perf|ci|build):"

# Get only the first line for validation
first_line=$(echo "$commit_msg" | head -n 1)

# Check if first line matches our format
if ! echo "$first_line" | grep -qE "$pattern"; then
  echo "${RED}❌ Invalid commit message format!${NC}"
  echo ""
  echo "${YELLOW}Required format:${NC}"
  echo "  ${GREEN}scope: short description${NC}"
  echo "  ${GREEN}${NC}"
  echo "  ${GREEN}Optional longer description on subsequent lines.${NC}"
  echo "  ${GREEN}Can be multiple paragraphs.${NC}"
  echo ""
  echo "${YELLOW}Examples:${NC}"
  echo "  ${GREEN}user-profile: Add avatar upload feature${NC}"
  echo "  ${GREEN}dashboard: Fix loading spinner alignment${NC}"
  echo ""
  echo "  ${GREEN}auth: Implement JWT token refresh${NC}"
  echo "  ${GREEN}${NC}"
  echo "  ${GREEN}Added automatic token refresh mechanism.${NC}"
  echo "  ${GREEN}This prevents unexpected logouts.${NC}"
  echo ""
  echo "${YELLOW}Your commit message (first line):${NC}"
  echo "  ${RED}$first_line${NC}"
  echo ""
  echo "${YELLOW}First line should be:${NC}"
  echo "  - lowercase letters, numbers, and hyphens in scope"
  echo "  - followed by colon and space"
  echo "  - then a short description"
  echo ""
  exit 1
fi

# Check for conventional commit keywords (only in first line)
if echo "$first_line" | grep -qiE "$conventional_keywords"; then
  echo "${RED}❌ Conventional commit keywords not allowed!${NC}"
  echo ""
  echo "${YELLOW}Please avoid using:${NC}"
  echo "  ${RED}feat, fix, docs, test, chore, perf, ci, build${NC}"
  echo ""
  echo "${YELLOW}Instead, use descriptive scopes like:${NC}"
  echo "  ${GREEN}feature-name, page-name, bug, api, ui, etc.${NC}"
  echo ""
  echo "${YELLOW}Your commit message:${NC}"
  echo "  ${RED}$commit_msg${NC}"
  echo ""
  exit 1
fi

# Success
echo "${GREEN}✅ Commit message format is valid!${NC}"
exit 0
